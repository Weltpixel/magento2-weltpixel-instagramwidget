<?php

// @codingStandardsIgnoreFile

$uniqueid = 'instagram-widget-' . uniqid();
$imagesPerRow = $this->getData('images_per_row');
$openImagesInNewTab = ($this->getData('images_in_new_tab')) ? 'target="_blank"' : '';
$imagesHavePadding = ($this->getData('images_have_padding')) ? 'use-padding' : '';
$imagesHaveCaption = ($this->getData('images_have_caption')) ? true : false;
$useImageShuffle = ($this->getData('optimize_image_layout')) ? true : false;
$useImageLazyLoad = ($this->isLazyLoadEnabled() && $this->getData('enable_lazyload'));
$showVideos = ($this->getData('show_videos')) ? true : false;
$description = trim($this->getData('description') ?? '');
$backgroundColor = trim($this->getData('background_color') ?? '');
/**
 * The value lands inside a style attribute, where escaping alone still allows a semicolon to
 * close the declaration and start another. Colors only: anything carrying ; : quotes or a
 * backslash is dropped rather than rendered.
 */
if ($backgroundColor !== '' && !preg_match('/^[#A-Za-z0-9(),.%\/\s-]+$/', $backgroundColor)) {
    $backgroundColor = '';
}
$title = trim($this->getData('title') ?? '');
$limit = intval($this->getData('limit') ?? '');
$token = $this->getInstagramToken();
$imagesAltTag = $this->getData('images_alt_text') ?? '0';
$imagesAltLabel = '';
$useHashTagFilter = ($this->getData('use_hashtag_filter')) ? true : false;
$hashTagFilter = trim($this->getData('hashtag_filter') ?? '');


$lazyloadPlaceholderWidth = $this->getLazyLoadPlaceholderWidth() ?? '100%';
switch ($imagesAltTag) {
    case '2':
        $imagesAltLabel = $block->escapeHtml(trim($this->getData('custom_alt_text')));
        break;
    case '0':
    default:
        $imagesAltLabel = '';
        break;
}
?>
<div class="instagram-widget-container " <?php if ($backgroundColor) : ?> style="background-color: <?= $block->escapeHtmlAttr($backgroundColor) ?>" <?php endif; ?>>
    <?php if ($title || $description) : ?>
    <div class="instagram-heading-title center">
        <?php if ($title) :  ?>
            <h3><?php echo $block->escapeHtml($title) ?></h3>
        <?php endif; ?>
        <?php if ($description) :  ?>
            <span class="center"><?php echo $block->escapeHtml($description) ?></span>
        <?php endif; ?>
    </div>
    <?php endif; ?>
    <div id="<?= $block->escapeHtmlAttr($uniqueid) ?>" class="instagram-photos <?= $block->escapeHtmlAttr($imagesPerRow . ' ' . $imagesHavePadding) ?>" ></div>
</div>
<div class="clear" >&nbsp;</div>
<script>
    require([
        'jquery',
        'instagramFeedBasic',
        'shufflejs',
        'underscore'
        <?php if ($useImageLazyLoad) : ?>
     ,'WeltPixel_LazyLoading/js/jquery_lazyload'
<?php endif  ?>
        ],
        function ($, instagramFeedBasic, Shuffle, _) {
            var $instagramPhotosEl = $('#<?= $block->escapeJs($uniqueid) ?>');
            if( $instagramPhotosEl.length > 0 ){

                $instagramPhotosEl.each(function() {
                    var instaGramTarget ='#<?= $block->escapeJs($uniqueid) ?>',
                        instaGramCount = <?= (int)$limit ?>,
                        instagramToken = '<?= $block->escapeJs($token) ?>',
                        instaImageNewTab = '<?= $block->escapeJs($openImagesInNewTab) ?>',
                        instaImagePadding = '<?= $block->escapeJs($imagesHavePadding) ?>',
                        useImageShuffle = '<?= $block->escapeJs($useImageShuffle) ?>',
                        useImageCaption = '<?= $block->escapeJs($imagesHaveCaption) ?>',
                        useImageLazyLoad = '<?= $block->escapeJs($useImageLazyLoad) ?>',
                        showVideos = '<?= $block->escapeJs($showVideos) ?>',
                        lazyLoadPlaceholderWidth = '<?= $block->escapeJs($lazyloadPlaceholderWidth) ?>',
                        useHashTagFilter = '<?= $block->escapeJs($useHashTagFilter) ?>',
                        hashTagFilter = '<?= $block->escapeJs($hashTagFilter) ?>',
                        instaImageAltTag = <?= (int)$imagesAltTag ?>,
                        instaImageAltLabel = '<?= $block->escapeJs($imagesAltLabel) ?>';


                    if( !instaGramCount ) { instaGramCount = 6; }
                    $.instagramFeedBasic({
                        'container': instaGramTarget,
                        'items': instaGramCount,
                        'token': instagramToken,
                        'image_new_tab' : instaImageNewTab,
                        'display_captions' : useImageCaption,
                        'image_padding' : instaImagePadding,
                        'image_alt_tag': instaImageAltTag,
                        'image_alt_label': instaImageAltLabel,
                        'image_lazy_load' : useImageLazyLoad,
                        'show_videos': showVideos,
                        'useHashTagFilter': useHashTagFilter,
                        'hashTagFilter': hashTagFilter,
                        'lazy_load_placeholder_width' : lazyLoadPlaceholderWidth,
                        'after': function() {
                            if (useImageShuffle) {
                               new Shuffle($instagramPhotosEl);
                                if (useImageLazyLoad) {
                                    $(window).scroll(_.debounce(function () {
                                        var evt = window.document.createEvent('UIEvents');
                                        evt.initUIEvent('resize', true, false, window, 0);
                                        window.dispatchEvent(evt);
                                    }, 350));
                                }
                            }
                        }
                    });
                });
            }
        });
</script>
